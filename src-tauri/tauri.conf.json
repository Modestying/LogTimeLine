{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogTimeLine",
  "version": "0.1.1",
  "identifier": "app.logtimeline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LogTimeLine",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "合并日志并按时间戳生成时序图",
    "longDescription": "导入、筛选、替换日志文本，并按时间戳生成时序图。",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
